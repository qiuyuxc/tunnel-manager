# Recommended: Cloudflare OAuth client credentials
CF_OAUTH_CLIENT_ID=your_cloudflare_oauth_client_id
CF_OAUTH_CLIENT_SECRET=your_cloudflare_oauth_client_secret
CF_OAUTH_REDIRECT_URI=https://your-domain.example/api/cloudflare/oauth/callback
# Optional; blank requests the scopes configured on the OAuth client
CF_OAUTH_SCOPES=

# Legacy fallback: static API token and account ID
CF_API_TOKEN=
CF_ACCOUNT_ID=
API_KEY=optional_api_key
APP_ENCRYPTION_KEY=base64_encoded_32_byte_key
# Optional. Leave it empty and the first visit to the panel opens the install
# wizard, where the administrator name and password are chosen by hand; set it
# to create the account at boot instead (handy for unattended installs).
ADMIN_PASSWORD=

# Storage. SQLite is used unless DATABASE_URL is set; a full table rewrite is
# fine on either backend, so nothing else changes when you switch.
STORE_PATH=data/tunnel-manager.db
# Optional PostgreSQL server; takes precedence over STORE_PATH, e.g.
# DATABASE_URL=postgres://tunnel:tunnel@127.0.0.1:5432/tunnel_manager?sslmode=disable
# Existing SQLite installs are not migrated automatically: the schema is
# created empty and the first boot opens the install wizard for a new account.
# Leave both STORE_PATH and DATABASE_URL empty to pick the backend in that
# wizard instead; the choice is stored in data/setup.json.
DATABASE_URL=
# Directory for uploads and heartbeat logs. Defaults to the SQLite file's
# directory; set it explicitly when the database is a PostgreSQL server.
DATA_DIR=
