<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/tm_canvas">

    <ScrollView
        android:id="@+id/auth_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="20dp">

            <Button
                android:id="@+id/language_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/language_label" />

            <!-- ==== sign-in step ==== -->
            <LinearLayout
                android:id="@+id/step_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="32dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:padding="18dp"
                    android:background="@drawable/auth_card"
                    android:layout_marginBottom="16dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/logo_mark" />

                <TextView
                    android:id="@+id/auth_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="?attr/tm_text"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/auth_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="28dp"
                    android:text="@string/m_1ccc64513061"
                    android:textColor="?attr/tm_muted"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/auth_card"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">
                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/m_d3716cc5a2f5" />
                <EditText
                    android:id="@+id/input_server"
                    style="@style/FieldInput"
                    android:layout_marginBottom="16dp"
                    android:autofillHints="url"
                    android:hint="http://192.168.1.10:8080"
                    android:imeOptions="actionNext"
                    android:inputType="textUri" />

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/m_70eadbef1274" />
                <EditText
                    android:id="@+id/input_account"
                    style="@style/FieldInput"
                    android:layout_marginBottom="16dp"
                    android:autofillHints="username"
                    android:hint="admin"
                    android:imeOptions="actionNext"
                    android:inputType="text" />

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/m_a621ab606db2" />
                <EditText
                    android:id="@+id/input_password"
                    style="@style/FieldInput"
                    android:layout_marginBottom="16dp"
                    android:autofillHints="current-password"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword" />
                </LinearLayout>

                <!-- Cloudflare Turnstile runs in a webview pinned to the console
                     origin, so the native form can satisfy it without handing the
                     whole sign-in over to the web page. -->
                <LinearLayout
                    android:id="@+id/turnstile_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <WebView
                        android:id="@+id/turnstile_view"
                        android:layout_width="300dp"
                        android:layout_height="70dp"
                        android:background="@android:color/transparent" />

                    <TextView
                        android:id="@+id/turnstile_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="?attr/tm_muted"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textColor="?attr/tm_error"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_login"
                    style="@style/PrimaryButton"
                    android:text="@string/m_27635321131e" />

                <Button
                    android:id="@+id/btn_passkey_login"
                    style="@style/GhostButton"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/input_bg"
                    android:textColor="?attr/tm_accent"
                    android:text="@string/m_e984682db258"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_use_web_login"
                    style="@style/GhostButton"
                    android:layout_marginTop="4dp"
                    android:text="@string/m_28a3e9056f79" />
            </LinearLayout>

            <!-- ==== two-factor step ==== -->
            <LinearLayout
                android:id="@+id/step_two_factor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginBottom="16dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/logo_mark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m_0e219bca12c0"
                    android:textColor="?attr/tm_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/two_factor_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="28dp"
                    android:gravity="center"
                    android:text="@string/m_235f957608aa"
                    android:textColor="?attr/tm_muted"
                    android:textSize="14sp" />

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/m_bb015c60bafc" />
                <EditText
                    android:id="@+id/input_code"
                    style="@style/FieldInput"
                    android:layout_marginBottom="16dp"
                    android:hint="000000"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="6" />

                <TextView
                    android:id="@+id/text_error_2fa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textColor="?attr/tm_error"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_verify"
                    style="@style/PrimaryButton"
                    android:text="@string/m_154723a1aa0a" />

                <Button
                    android:id="@+id/btn_passkey_verify"
                    style="@style/GhostButton"
                    android:layout_marginTop="4dp"
                    android:text="@string/m_28c3158cdf27"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_back_to_login"
                    style="@style/GhostButton"
                    android:layout_marginTop="4dp"
                    android:text="@string/m_572cf45ba436" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>
